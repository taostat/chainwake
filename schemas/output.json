    "AuthErrorPayload": {
      "additionalProperties": false,
      "description": "Authentication failure \u2014 chain rejected the request as unauthenticated.\n\nSpec \u00a79.4 / Appendix D: emitted as its own top-level status (not folded\ninto ``provider_error``) so agents can match the documented spec string\nand so the payload itself carries actionable hints (env-var names, docs\nURL) rather than burying them in the message.",
      "properties": {
        "api_key_env_vars": {
          "description": "Environment variables the user can set to provide an API key.",
          "items": {
            "type": "string"
          },
          "title": "Api Key Env Vars",
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThresholdCondition"
            },
            {
              "$ref": "#/$defs/DeltaCondition"
            },
            {
              "$ref": "#/$defs/StateCondition"
            },
            {
              "$ref": "#/$defs/LivenessCondition"
            },
            {
              "$ref": "#/$defs/EventCondition"
            },
            {
              "$ref": "#/$defs/TxCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "docs_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Link to provider signup / API-key documentation.",
          "title": "Docs Url"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "default": null,
          "title": "Observed",
          "type": "null"
        },
        "process": {
          "$ref": "#/$defs/Process"
        },
        "reason": {
          "default": "auth_failed",
          "enum": [
            "auth_failed",
            "missing_api_key",
            "invalid_api_key",
            "expired_api_key"
          ],
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "auth_error",
          "default": "auth_error",
          "title": "Status",
          "type": "string"
        },
        "watcher": {
          "anyOf": [
            {
              "$ref": "#/$defs/Watcher"
            },
            {
              "type": "null"
            }
