{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.taostat/chainwake",
  "title": "Blockmachine Chainwake",
  "description": "Bittensor and EVM chain monitoring for AI agents",
  "repository": {
    "url": "https://github.com/taostat/chainwake",
    "source": "github"
  },
  "version": "0.5.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "chainwake",
      "version": "0.5.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "positional",
          "value": "--stdio"
        }
      ]
    }
  ]
}
